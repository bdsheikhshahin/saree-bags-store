PORT=4000
MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
# Public storefront URL — payment gateways redirect the shopper back here.
WEB_URL=http://localhost:3000

# --- SSLCommerz (sandbox by default) ---
# Test credentials come from the SSLCommerz store panel (sandbox store).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Set to false only when using live credentials.
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_IS_LIVE=false
# Override only if SSLCommerz changes its endpoints; sandbox URLs are the defaults.
SSLCOMMERZ_INIT_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# --- bKash (tokenized checkout, sandbox by default) ---
# Test credentials come from the bKash developer portal (sandbox app).
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# --- Nagad (sandbox by default) ---
# Test credentials come from the Nagad merchant panel (sandbox merchant).
NAGAD_MERCHANT_ID=
# PEM-encoded keys (single line with \n escapes is fine) or full PEM blocks.
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_SANDBOX=true
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
