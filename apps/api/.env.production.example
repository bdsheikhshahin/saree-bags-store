# Production environment for the Express API (apps/api)
#
# HOW TO USE
#   cp apps/api/.env.production.example apps/api/.env.production
#   ...then replace every placeholder below with your REAL production values.
#   NEVER commit the real .env.production file (placeholders only in git).
#   NEVER paste real keys into chat, screenshots or a shared document.

# Port the API listens on inside its container. Keep 4000 unless your host
# requires something else.
PORT=4000

# MongoDB connection string.
#   Docker Compose (this repo's mongo service):  mongodb://mongo:27017/ecommerce
#     (docker-compose.yml already sets this for you — it overrides this line.)
#   MongoDB Atlas (cloud database):               mongodb+srv://<db-username>:<db-password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
#     Replace <db-username>, <db-password> and <cluster> with your Atlas values.
#     See DEPLOY.md section (d) for the Atlas setup steps.
MONGO_URI=mongodb+srv://<db-username>:<db-password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority

# Secret used to sign admin login tokens (JWT). MUST be a long random string
# (at least 32 characters) that nobody else knows. Generate one with:
#   openssl rand -base64 48
# and paste the result here. If this leaks or you change it, every admin is
# logged out and must log in again — that is expected and safe.
JWT_SECRET=<paste-a-long-random-secret-here-at-least-32-characters>

# How long an admin login stays valid. 7d = 7 days.
JWT_EXPIRES_IN=7d

# The ONLY website allowed to call this API from a browser. Must be your
# store's exact public address (no trailing slash, no extra paths).
#   Local development was: http://localhost:3000
#   Production example:   https://www.yourshop.com.bd
# If this is wrong, the store will load but products/orders will fail with
# a CORS error in the browser console.
CORS_ORIGIN=https://www.yourshop.com.bd

# Admin account created by `npm run seed`. CHANGE BOTH before seeding a
# production database — the seed uses these values, and anyone who knows the
# demo defaults could log in to your admin panel.
ADMIN_EMAIL=admin@yourshop.com.bd
ADMIN_PASSWORD=<choose-a-strong-password-here>

# --- Bangladesh payments (placeholders only — fill in after Phase 4) -------
# Today the payment code is a stub: no real money moves, and these values are
# only read, not used to charge anyone. When the real gateway integration
# lands, paste your LIVE merchant credentials here.
#
# SSLCommerz — sandbox or live is chosen by SSLCOMMERZ_IS_LIVE:
#   false = sandbox (test) credentials, true = live credentials.
#   Get them from your SSLCommerz merchant panel (store ID + store password).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
#
# bKash — there is NO sandbox/live switch in the code: sandbox vs live is
# decided by WHICH app key/secret you paste (sandbox credentials from the
# bKash sandbox portal, live credentials from your bKash merchant account).
BKASH_APP_KEY=
BKASH_APP_SECRET=
#
# Nagad — same as bKash: no sandbox/live switch in the code. Paste your
# sandbox merchant ID while testing, your live merchant ID when going live.
NAGAD_MERCHANT_ID=
