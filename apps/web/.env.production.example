# Production environment for the Next.js storefront (apps/web)
#
# HOW TO USE
#   cp apps/web/.env.production.example apps/web/.env.production
#   ...then replace every placeholder below with your REAL production values.
#   NEVER commit the real .env.production file (placeholders only in git).
#
# IMPORTANT — these NEXT_PUBLIC_* values are baked into the website when the
# image is BUILT (Next.js inlines them into the JavaScript sent to the
# browser). Changing them later requires a rebuild:
#   Vercel:   change the variable in the Vercel dashboard, then redeploy.
#   Docker:   NEXT_PUBLIC_API_URL=<new-url> docker compose up -d --build web

# Your store's public address (no trailing slash). Used for SEO metadata
# (canonical URLs, sitemap, social sharing).
NEXT_PUBLIC_SITE_URL=https://www.yourshop.com.bd

# Your API's PUBLIC address (no trailing slash) — the address the VISITOR'S
# browser calls. It must be reachable from the public internet.
#   VPS + Docker Compose:  http://<your-vps-ip>:4000  (or https://api.yourshop.com.bd
#                          if you put a domain / reverse proxy in front of it)
#   Vercel + Render:       https://<your-api-service>.onrender.com
# Do NOT use http://localhost:4000 or http://api:4000 here — those only work
# on your own computer / inside Docker, not in a visitor's browser.
NEXT_PUBLIC_API_URL=https://api.yourshop.com.bd

# Google Tag Manager container ID for GA4 (via GTM). Leave as GTM-XXXXXXX
# (or empty) if you have not set up GTM yet — analytics will simply stay off.
# Get your real ID from https://tagmanager.google.com after creating a
# container for your store.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Default analytics consent before the visitor accepts the cookie banner:
# "denied" is correct — the banner flips it to "granted" after consent.
NEXT_PUBLIC_GA_CONSENT_DEFAULT=denied
