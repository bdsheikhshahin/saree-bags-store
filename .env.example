# Copy to apps/web/.env.local and apps/api/.env (see each app's own .env.example)
# --- Web (Next.js) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Consent: set to "granted" only after the user accepts cookies, otherwise "denied"
NEXT_PUBLIC_GA_CONSENT_DEFAULT=denied

# --- API (Express) ---
PORT=4000
MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
# Bangladesh payments — placeholders only, fill with real merchant credentials later.
# Do NOT commit real keys. No Stripe is used in this project.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=
