# Files that must NEVER be copied into the Docker build context.
# In particular: host node_modules / build output (the image builds its own),
# the local MongoDB data directory, and any real .env file with secrets.

.git
.data

# Dependencies and build output — rebuilt inside the image.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
out
**/out
*.tsbuildinfo
**/*.tsbuildinfo

# Real environment files (with secrets). Only the *.example templates are
# safe to copy; they contain placeholders, not real values.
.env
.env.local
.env.production
.env.*.local

# Logs and OS junk.
*.log
.DS_Store
