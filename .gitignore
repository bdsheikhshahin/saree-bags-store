# dist/ — compiled output is committed so cPanel shared hosting
# can run `node dist/index.js` without needing a build step on the server.
# Only the web (.next) and local dev output are excluded:
.next/
out/
.env
.env.local
.env.production
apps/*/.env.production
*.log
.DS_Store

# Local-only: MongoDB data + binary (VM)
.data/
.tools/
